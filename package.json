{
  "name": "nandoos",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "pnpm --filter @nandoos/contracts build && pnpm --parallel --filter @nandoos/web --filter @nandoos/api dev",
    "build": "pnpm --recursive --if-present run build",
    "lint": "pnpm --recursive --if-present run lint",
    "typecheck": "pnpm --filter @nandoos/contracts build && pnpm --recursive --if-present run typecheck",
    "test": "pnpm --filter @nandoos/contracts build && pnpm --recursive --if-present run test"
  }
}
