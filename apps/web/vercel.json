{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/proxy?__nandos_path=:path*"
    },
    {
      "source": "/proyectos",
      "destination": "/index.html"
    },
    {
      "source": "/proyectos/nandos",
      "destination": "/index.html"
    },
    {
      "source": "/contacto",
      "destination": "/index.html"
    }
  ]
}
